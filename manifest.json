{
  "manifest_version": 3,
  "name": "BrandCloak - Stealth Commuter Privacy",
  "version": "1.0.2",
  "description": "Shields corporate branding and organization logos across Google Workspace and Jira to protect privacy in public spaces.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "BrandCloak Stealth Mode",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://mail.google.com/*",
        "*://drive.google.com/*",
        "*://docs.google.com/*",
        "*://calendar.google.com/*",
        "*://meet.google.com/*"
      ],
      "css": ["content/cloak-styles.css"],
      "js": ["content/common-utils.js", "content/cloak-google.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.atlassian.net/*",
        "*://*.jira.com/*"
      ],
      "css": ["content/cloak-styles.css"],
      "js": ["content/common-utils.js", "content/cloak-jira.js"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "commands": {
    "toggle-stealth": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Toggle BrandCloak Stealth Mode"
    }
  }
}
